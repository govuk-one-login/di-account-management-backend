{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "di-account-management-backend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            },
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/lint-and-test-lambdas.yaml",
          "path": "$.jobs.lint_and_test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/checkov.yml",
          "path": "$.jobs.checkov"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/detect-secrets.yaml",
          "path": "$.jobs.detect-secrets"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/sonarcloud.yaml",
          "path": "$.jobs.sonarcloud_home_backend"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/pre-merge.yaml",
          "path": "$.jobs.test"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/sam-app-post-merge-actions.yaml",
          "path": "$.jobs.deploy"
        }
      ]
    }
  ]
}
