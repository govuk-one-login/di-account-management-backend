{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "home",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression",
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint-and-test-lambdas.yaml",
            "path": "$.jobs.lint_and_test"
          }
        },
        {
          "checkTypes": [
            "code quality"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checkov.yml",
            "path": "$.jobs.checkov"
          }
        },
        {
          "checkTypes": [
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/detect-secrets.yaml",
            "path": "$.jobs.detect-secrets"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yaml",
            "path": "$.jobs.sonarcloud_home_backend"
          }
        },
        {
          "checkTypes": [
            "integration",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge.yaml",
            "path": "$.jobs.test"
          }
        },
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression"
          ],
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sam-app-post-merge-actions.yaml",
            "path": "$.jobs.deploy"
          }
        }
      ]
    }
  ]
}
