{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "di-account-management-backend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint-and-test-lambdas.yaml",
            "path": "$.jobs.lint_and_test"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "new feature"
            },
            {
              "name": "regression"
            },
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checkov.yml",
            "path": "$.jobs.checkov"
          },
          "checks": [
            {
              "name": "code quality"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/detect-secrets.yaml",
            "path": "$.jobs.detect-secrets"
          },
          "checks": [
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yaml",
            "path": "$.jobs.sonarcloud_home_backend"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge.yaml",
            "path": "$.jobs.test"
          },
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sam-app-post-merge-actions.yaml",
            "path": "$.jobs.deploy"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "new feature"
            },
            {
              "name": "regression"
            }
          ]
        }
      ]
    }
  ]
}
