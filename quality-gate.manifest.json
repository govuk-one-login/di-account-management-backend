{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "home",
      "component": "home",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/lint.yaml",
          "path": "$.jobs.lint"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/dependency-review.yaml",
          "path": "$.jobs.dependency-review"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/sonarcloud.yaml",
          "path": "$.jobs.sonarcloud_home_backend"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/local-tests-unit.yaml",
          "path": "$.jobs.local-tests-unit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/deployed-tests.yaml",
          "path": "$.jobs.deployed-tests"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/sam-app-post-merge-actions.yaml",
          "path": "$.jobs.deploy"
        },
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": "post-deploy-tests.Dockerfile"
        }
      ]
    }
  ]
}
